# Copy to personal.properties (gitignored) and fill in. Format: Name:MM-DD, comma-separated.
birthdays=Alex:01-31,Sam:12-02

# Optional: Home Assistant, with a long-lived access token. Then any of the integrations below.
# ha_url=http://192.168.1.20:8123
# ha_token=
# Lights: tinted in the selected app's colour while the wheel spins.
# ha_lights=light.tv_left,light.tv_right
# Movie mode: dimmed while one of tv.properties' movie_apps is on.
# ha_movie_lights=light.tv_left,light.tv_right,light.side_table_lamp
# Laundry: a banner when one of these sensors turns "done".
# ha_washer=sensor.washer_status
# ha_dryer=sensor.dryer_status
