<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <dev.mrrosoff.tv.dot.dots.DotFieldView
        android:id="@+id/dot_field"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/occasion_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <dev.mrrosoff.tv.dot.dots.ParticleView
        android:id="@+id/particles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/glow"
        android:layout_width="620dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <dev.mrrosoff.tv.dot.home.WheelView
        android:id="@+id/wheel"
        android:layout_width="500dp"
        android:layout_height="match_parent"
        android:layout_marginStart="44dp" />

    <LinearLayout
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="64dp"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/occasion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/emblem"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no" />

            <dev.mrrosoff.tv.dot.dots.DotTextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:dotPitch="2.6dp" />
        </LinearLayout>

        <dev.mrrosoff.tv.dot.dots.DotTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:dotColor="@color/text"
            app:dotPitch="7dp" />

        <dev.mrrosoff.tv.dot.dots.DotTextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:dotColor="@color/text_faint"
            app:dotPitch="2.4dp" />

        <LinearLayout
            android:id="@+id/weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/weather_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                android:tint="@color/text" />

            <dev.mrrosoff.tv.dot.dots.DotTextView
                android:id="@+id/temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:dotColor="@color/text"
                app:dotPitch="4dp" />

            <dev.mrrosoff.tv.dot.dots.DotTextView
                android:id="@+id/condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                app:dotColor="@color/text_faint"
                app:dotPitch="2.4dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/voice_panel"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="52dp"
        android:background="@drawable/panel"
        android:focusable="false"
        android:padding="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <dev.mrrosoff.tv.dot.dots.DotTextView
                android:id="@+id/voice_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                app:dotColor="@color/text_faint"
                app:dotPitch="1.8dp" />

            <dev.mrrosoff.tv.dot.dots.DotTextView
                android:id="@+id/voice_heard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                app:dotColor="@color/text"
                app:dotPitch="3dp" />

            <LinearLayout
                android:id="@+id/voice_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/inputs_panel"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="52dp"
        android:background="@drawable/panel"
        android:focusable="false"
        android:padding="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/inputs_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</merge>
