<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <dev.mrrosoff.tv.dot.dots.DotFieldView
        android:id="@+id/dot_field"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/occasion_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <dev.mrrosoff.tv.dot.dots.ParticleView
        android:id="@+id/particles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/glow"
        android:layout_width="620dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <dev.mrrosoff.tv.dot.home.WheelView
        android:id="@+id/wheel"
        android:layout_width="520dp"
        android:layout_height="match_parent"
        android:layout_marginStart="44dp" />

    <LinearLayout
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/network"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:alpha="0.6"
            android:contentDescription="@string/network"
            android:src="@drawable/ic_wifi_3"
            android:tint="@color/text" />

        <ImageView
            android:id="@+id/settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/focus_circle"
            android:clickable="true"
            android:contentDescription="@string/settings"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/pill_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="92dp"
        android:layout_marginEnd="64dp"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/occasion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <dev.mrrosoff.tv.dot.dots.DotIconView
                android:id="@+id/emblem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp" />

            <dev.mrrosoff.tv.dot.dots.DotTextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:dotPitch="2.4dp" />
        </LinearLayout>

        <dev.mrrosoff.tv.dot.dots.DotTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:dotColor="@color/text"
            app:dotPitch="7dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <dev.mrrosoff.tv.dot.dots.DotTextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:dotColor="@color/text_faint"
                app:dotPitch="2.4dp" />

            <LinearLayout
                android:id="@+id/weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <dev.mrrosoff.tv.dot.dots.DotTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:dotColor="@color/text_faint"
                    app:dotPitch="2.4dp"
                    app:dotText="·" />

                <dev.mrrosoff.tv.dot.dots.DotIconView
                    android:id="@+id/weather_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp" />

                <dev.mrrosoff.tv.dot.dots.DotTextView
                    android:id="@+id/temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:dotColor="@color/text_faint"
                    app:dotPitch="2.4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/inputs_panel"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="92dp"
        android:layout_marginEnd="52dp"
        android:background="@drawable/panel"
        android:focusable="false"
        android:padding="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/inputs_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</merge>
