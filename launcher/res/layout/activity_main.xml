<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/dot_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/occasion_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <dev.mrrosoff.braviatv.dots.ParticleView
        android:id="@+id/particles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/glow"
        android:layout_width="620dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <dev.mrrosoff.braviatv.home.WheelView
        android:id="@+id/wheel"
        android:layout_width="520dp"
        android:layout_height="match_parent"
        android:layout_marginStart="44dp" />

    <LinearLayout
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="64dp"
        android:gravity="end"
        android:orientation="vertical">

        <dev.mrrosoff.braviatv.dots.DotIconView
            android:id="@+id/emblem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:visibility="gone" />

        <dev.mrrosoff.braviatv.dots.DotTextView
            android:id="@+id/greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:dotColor="@color/text_faint"
            app:dotPitch="2.4dp" />

        <dev.mrrosoff.braviatv.dots.DotTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:dotColor="@color/text"
            app:dotPitch="7dp" />

        <dev.mrrosoff.braviatv.dots.DotTextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:dotColor="@color/text_faint"
            app:dotPitch="2.4dp" />

        <LinearLayout
            android:id="@+id/weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <dev.mrrosoff.braviatv.dots.DotIconView
                android:id="@+id/weather_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <dev.mrrosoff.braviatv.dots.DotTextView
                android:id="@+id/temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                app:dotColor="@color/text"
                app:dotPitch="4dp" />
        </LinearLayout>

        <dev.mrrosoff.braviatv.dots.DotTextView
            android:id="@+id/city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:dotColor="@color/text_faint"
            app:dotPitch="1.8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="44dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/network"
            style="@style/IconButton"
            android:contentDescription="@string/network"
            android:src="@drawable/ic_wifi_4" />

        <ImageView
            android:id="@+id/settings"
            style="@style/IconButton"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/inputs_panel"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="100dp"
        android:background="@drawable/panel"
        android:focusable="false"
        android:padding="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/inputs_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</merge>
